<Placemark><name>Бирюзовая крышка/миска</name><description>триангуляция, General #1641. Высота 4531 м.</description><Point><altitudeMode>absolute</altitudeMode><coordinates>73.585443,39.483144,4531</coordinates></Point></Placemark>
